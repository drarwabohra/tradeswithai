# Use your provider's verified TLS connection string. Do not disable certificate verification.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
APP_ORIGIN=http://localhost:3000
# Generate separate random values of at least 32 characters. Never prefix these with NEXT_PUBLIC_.
ORDER_TOKEN_SECRET=
ORDER_WEBHOOK_URL=https://YOUR-WEBHOOK-ENDPOINT
ORDER_WEBHOOK_SECRET=
CRON_SECRET=
# Set only after verifying your proxy overwrites this header; otherwise a shared limit is used.
TRUSTED_CLIENT_IP_HEADER=
